# Copy to .env.local. `bun run db:local` starts the matching Postgres.
DATABASE_URL=postgresql://omel@localhost:54329/omel
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_ENV=dev
NEXT_PUBLIC_DEBUG=true

# Optional. Without Upstash, rate limits are kept in memory per server process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional integrations; each one stays off while its value is empty.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
RESEND_API_KEY=
ABSTRACT_API_KEY=
POLAR_SANDBOX_KEY=
